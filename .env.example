# Copiez ce fichier en `.env` puis complétez les valeurs (voir docs/00-installation.md).
# Ne commitez JAMAIS le fichier `.env`.

# --- Base de données partagée (Neon) --------------------------------------
# L'URL complète vous est communiquée par l'enseignant le jour de l'atelier.
# Elle doit :
#   - utiliser l'hôte « pooled » de Neon (le nom d'hôte contient « -pooler ») ;
#   - se terminer par les paramètres ci-dessous.
#     * pgbouncer=true     : Prisma doit travailler avec le pooler PgBouncer de Neon ;
#     * connection_limit=3 : 3 connexions maximum par poste (la base est partagée par toute la classe) ;
#     * sslmode=require    : connexion chiffrée obligatoire ;
#     * connect_timeout=15 : laisse le temps à Neon de se « réveiller ».
# Forme attendue :
#   postgresql://<UTILISATEUR>:<MOT_DE_PASSE>@<HOTE>-pooler.<REGION>.aws.neon.tech/<BASE>?sslmode=require&pgbouncer=true&connection_limit=3&connect_timeout=15
DATABASE_URL="A_REMPLACER_PAR_L_URL_DONNEE_PAR_L_ENSEIGNANT"

# --- Authentification -----------------------------------------------------
# Secrets propres à VOTRE poste : générez deux valeurs différentes avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="A_GENERER"
JWT_REFRESH_SECRET="A_GENERER"

# --- Divers ---------------------------------------------------------------
FRONTEND_ORIGIN="http://localhost:3001"
PORT=3000
# Swagger : http://localhost:3000/api/docs
SWAGGER_ENABLED=true
